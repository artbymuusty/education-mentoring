# Supabase — from Project Settings → API in your Supabase dashboard.
# Never commit the real values; copy this file to .env.local and fill it in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deployment-level fallback domain (lib/site-config.ts). Used for
# canonical/sitemap/OG URLs ONLY until an admin sets a real production
# domain at /admin/settings — once one is saved there, the database value
# wins. Still worth setting to your real domain so the app has a correct
# URL to boot with on first deploy, before anyone has opened the admin panel.
NEXT_PUBLIC_SITE_URL=https://rtgdanismanlik.example.com

# Everything business-related (WhatsApp number, contact email,
# company/legal identity, social links, production domain) is entered at
# /admin/settings and stored in the database, NOT as an env var. Do not
# add NEXT_PUBLIC_WHATSAPP_NUMBER, NEXT_PUBLIC_CONTACT_EMAIL,
# NEXT_PUBLIC_INSTAGRAM_URL, or NEXT_PUBLIC_LEGAL_* here — none of these
# are read from env anymore.

# Preview only — leave unset/false in production. When "true", the
# Mentorluk and Öğrenci Hikayeleri sections render clearly-labeled DEMO
# content (lib/content/*.demo.ts) instead of staying hidden, so you can
# see the design before real mentors/stories exist. Real visitors must
# never see this on by accident, which is why every demo card also shows
# a visible "Örnek" badge regardless of this flag.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=
