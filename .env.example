# Supabase — from Project Settings → API in your Supabase dashboard.
# Never commit the real values; copy this file to .env.local and fill it in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site config (lib/site-config.ts reads these). Leave blank until the
# real value exists — the UI hides the dependent button/section rather than
# falling back to a placeholder, so an empty value here is always safe.
NEXT_PUBLIC_SITE_URL=https://education-mentoring.example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Legal/corporate identity for the footer and /gizlilik, /kvkk,
# /kullanim-sartlari pages. Leave blank until the real company is
# registered — pages read siteConfig.name as a neutral fallback and omit
# any line that depends on a field left empty here.
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_COMPANY_ADDRESS=
NEXT_PUBLIC_LEGAL_MERSIS_NO=
NEXT_PUBLIC_LEGAL_TAX_OFFICE=
NEXT_PUBLIC_LEGAL_TAX_NUMBER=
